{
  "name": "seminar-v2",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run migration:run --workspace=apps/backend",
    "db:seed:admin": "npm run seed:admin --workspace=apps/backend"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "plantuml-encoder": "^1.4.0"
  }
}
