# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://seminar_user:seminar_pass@localhost:5432/seminar_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — Store Owner
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=24h

# JWT — Admin
JWT_ADMIN_SECRET=your-admin-jwt-secret-change-in-production
JWT_ADMIN_EXPIRES_IN=8h

# SMTP Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Phố Ẩm Thực <noreply@phoamthuc.vn>"

# Admin Seed
ADMIN_EMAIL=admin@phoamthuc.vn
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Admin

# Bull Board (job queue dashboard)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=bullboard_pass

# MinIO / S3-compatible Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=seminar-media
MINIO_USE_SSL=false

# Google OAuth (Customer authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# JWT — Customer (Google OAuth issued, short-lived)
CUSTOMER_JWT_SECRET=your-customer-jwt-secret-change-in-production
CUSTOMER_JWT_EXPIRES_IN=1h

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
SUPPORTED_LANGUAGES=["en","fr","zh","ja","ko","th"]
