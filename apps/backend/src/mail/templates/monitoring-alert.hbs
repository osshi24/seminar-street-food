<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;">
    <div style="max-width:640px;margin:0 auto;padding:24px;">
      <div style="background:#b91c1c;color:#fff;padding:16px 18px;border-radius:12px;">
        <div style="font-size:12px;opacity:0.9;">Phố Ẩm Thực · Cảnh báo giám sát</div>
        <div style="font-size:18px;font-weight:700;margin-top:6px;">{{title}}</div>
      </div>

      <div style="background:#ffffff;padding:18px;border-radius:12px;margin-top:14px;box-shadow:0 1px 2px rgba(16,24,40,0.06);">
        <div style="font-size:14px;color:#111827;line-height:1.6;">
          <p><strong>Loại cảnh báo:</strong> {{kind}}</p>
          <p><strong>Thời điểm:</strong> {{ts}}</p>
          <p><strong>Mô tả:</strong> {{message}}</p>
          {{#if details}}
            <pre style="background:#f3f4f6;padding:12px;border-radius:8px;font-size:12px;overflow:auto;">{{details}}</pre>
          {{/if}}
        </div>
      </div>

      <div style="margin-top:14px;color:#6b7280;font-size:12px;line-height:1.5;">
        Email tự động từ MonitoringModule. Cảnh báo trùng loại sẽ bị bỏ qua trong 15 phút tiếp theo.
      </div>
    </div>
  </body>
</html>
