@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam sequenceParticipantBorderColor #555
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceLifeLineBackgroundColor #FFFFFF
skinparam noteBorderColor #888
skinparam noteBackgroundColor #FFFDE7

title Sequence Diagram - Quy trình duyệt thông tin gian hàng (UC-A03)

actor "Admin" as Admin
participant "Web UI" as UI
participant "AdminStores\nController" as Ctrl
participant "AdminStores\nService" as Service
participant "BullMQ\n(Queues)" as Queue
participant "Notifications\nService" as Notify
database "Database\n(Transaction)" as DB

Admin -> UI: Xem bản nháp và\nnhấn "Phê duyệt"
activate UI

UI -> Ctrl: PATCH /api/admin/store-drafts/{id}/approve
activate Ctrl

Ctrl -> Service: approveDraft(adminId, draftId)
activate Service

Service -> DB: findOne(draftId)
activate DB
DB --> Service: draft (status: PENDING)
deactivate DB

alt [Draft không hợp lệ]
    Service --> Ctrl: BadRequestException
    Ctrl --> UI: 400 Bad Request
else [Hợp lệ]
    Service -> DB: Bắt đầu Transaction
    activate DB
    
    Service -> DB: Cập nhật Draft status = APPROVED
    Service -> DB: Cập nhật Store status = ACTIVE\n& thông tin mới
    Service -> DB: Commit MenuItems & StoreImages\n(isInDraft = false)
    Service -> DB: Tạo Commentary record\n(pipelineStatus = PENDING)
    Service -> DB: Cập nhật Store.activeCommentaryId
    
    DB --> Service: Transaction Commit thành công
    deactivate DB

    Service -> Queue: commentaryQueue.add('process')
    activate Queue
    Queue --> Service: job enqueued
    deactivate Queue

    Service -> Queue: storeTranslationQueue.add('translate-store')
    activate Queue
    Queue --> Service: job enqueued
    deactivate Queue

    Service -> Notify: create(event='STORE_DRAFT_APPROVED')
    activate Notify
    Notify --> Service: notification created
    deactivate Notify

    Service --> Ctrl: void
end

deactivate Service

Ctrl --> UI: 200 OK
deactivate Ctrl

UI --> Admin: Hiển thị "Đã duyệt thông tin"
deactivate UI

@enduml
